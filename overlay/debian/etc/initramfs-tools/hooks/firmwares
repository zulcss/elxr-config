#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later

PREREQ=""

prereqs()
{
	echo "$PREREQ"
}

case $1 in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/scripts/functions
. /usr/share/initramfs-tools/hook-functions

cp -rpP /usr/lib/firmware/* ${DESTDIR}/usr/lib/firmware/ || return $?

