#!/bin/bash
# Prepare L4T flash image for 6.12 kernel.
#
# After apply_binaries.sh installs the L4T 5.15 kernel, this script:
# 1. Replaces /boot/Image with the 6.12 kernel
# 2. Patches nv-update-initrd version detection (strings fails under qemu)
# 3. Removes ucsi_ccg.ko from initrd modules list (not built in 6.12)
#
# Run this AFTER apply_binaries.sh, BEFORE l4t_update_initrd.sh.
# Usage (from Linux_for_Tegra/):
#   sudo rootfs/usr/local/bin/elxr-fix-l4t-initrd rootfs

set -e

ROOTFS="${1:-.}"
NV_SCRIPT="${ROOTFS}/usr/sbin/nv-update-initrd"
MODULES_LIST="${ROOTFS}/etc/nv-update-initrd/list.d/modules"
KERNEL_VERSION="6.12.48+deb13-orin-arm64"
VMLINUZ="${ROOTFS}/boot/vmlinuz-${KERNEL_VERSION}"

if [ ! -f "${NV_SCRIPT}" ]; then
    echo "Error: ${NV_SCRIPT} not found. Run apply_binaries.sh first."
    exit 1
fi

# Fix 1: replace 5.15 kernel with 6.12
if [ -f "${VMLINUZ}" ]; then
    cp "${VMLINUZ}" "${ROOTFS}/boot/Image"
    echo "Copied ${KERNEL_VERSION} to ${ROOTFS}/boot/Image"

    # Also copy to kernel/Image as gzip (flash.sh expects gzip format)
    LDK_DIR="$(dirname "${ROOTFS}")"
    if [ -d "${LDK_DIR}/kernel" ]; then
        cp "${VMLINUZ}" "${LDK_DIR}/kernel/Image.uncompressed"
        gzip -c "${VMLINUZ}" > "${LDK_DIR}/kernel/Image"
        echo "Copied ${KERNEL_VERSION} to ${LDK_DIR}/kernel/Image (gzip-compressed for flash.sh)"
    fi
else
    echo "Warning: ${VMLINUZ} not found, skipping kernel copy."
fi

# Fix 2: patch version detection fallback
if ! grep -q "elxr-fallback" "${NV_SCRIPT}"; then
    sed -i '/echo "${_kernel_version}"/i\
\t# elxr-fallback: if strings failed, read version from /lib/modules/\
\tif [ -z "${_kernel_version}" ]; then\
\t\t_kernel_version=$(ls -1 /lib/modules/ 2>/dev/null | grep -v "^5\\." | sort -V | tail -1)\
\tfi' "${NV_SCRIPT}"
    echo "Patched ${NV_SCRIPT} with kernel version fallback."
else
    echo "Version fallback already patched."
fi

# Fix 3: remove ucsi_ccg.ko (not built in 6.12 config)
if [ -f "${MODULES_LIST}" ] && grep -q "ucsi_ccg" "${MODULES_LIST}"; then
    sed -i '/ucsi_ccg/d' "${MODULES_LIST}"
    echo "Removed ucsi_ccg.ko from initrd modules list."
else
    echo "No ucsi_ccg entry to remove."
fi

echo ""
echo "Done. Next steps:"
echo "  sudo ./tools/l4t_update_initrd.sh"
echo "  sudo ./flash.sh jetson-agx-orin-devkit mmcblk0p1"
